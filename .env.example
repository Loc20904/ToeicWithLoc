# Cấu hình API Key và Google Sheets cho Toeic_PDF2quizlet

# 1. API Key của Gemini (Lấy tại: https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Access Key của Unsplash (Lấy tại: https://unsplash.com/developers - Tùy chọn)
# Nếu để trống hoặc không nhập, script sẽ tự động dùng link ảnh fallback miễn phí
UNSPLASH_ACCESS_KEY=

# 3. Tên Google Sheet cần ghi dữ liệu vào
SPREADSHEET_NAME=Quizlet_Vocab_Import

# 4. Tên file credentials của Google Cloud Service Account
# File này phải đặt ở thư mục gốc của dự án
GOOGLE_CREDENTIALS_FILE=credentials.json
